PORT=5000
DATABASE_URL="file:./voicenova.db"
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
NODE_ENV=development

# ─── AI Provider Configuration ────────────────────────────────────────────────
# Active provider: elevenlabs | openai | azure (future)
AI_PROVIDER=elevenlabs

# ─── ElevenLabs API ───────────────────────────────────────────────────────────
# Replace with your real ElevenLabs API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
# Model to use: eleven_monolingual_v1 | eleven_multilingual_v2 | eleven_turbo_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# HTTP timeout in milliseconds for synthesis calls
ELEVENLABS_TIMEOUT_MS=30000
# Maximum retry attempts on retriable errors (429, 5xx)
ELEVENLABS_MAX_RETRIES=3

# ─── Audio Storage ─────────────────────────────────────────────────────────────
# Local path for storing generated audio files (relative to backend root)
AUDIO_STORAGE_PATH=./09-uploads
